# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# C extensions
*.so

# Distribution / packaging
.Python
build/
dist/
wheels/
*.egg-info/
*.egg

# Installer logs
pip-log.txt
pip-delete-this-file.txt

# Unit test / coverage reports
.pytest_cache/
.coverage
htmlcov/

# PyInstaller / cx_Freeze
# These folders usually contain binary files resulting from compilation
# (tùy chọn - nếu bạn sử dụng các công cụ này)
installer/
frozen/

# Environments (Môi trường ảo)
# Thư mục môi trường ảo phổ biến (vd: venv, env)
venv/
env/
myenv/

# Editor/OS temporary files
.DS_Store
*.swp
*.bak
*~
.idea/
.vscode/

# Jupyter Notebook files
.ipynb_checkpoints

# Miscellaneous
/instance/
.webassets-cache